+class CaretHider {
+  var _cancelable: AnyCancellable? = nil
+  weak var _view: UIView?
+
+  private static func findCursorViews(in root: UIView) -> [UIView] {
+    var result: [UIView] = []
+    for subview in root.subviews {
+      let className = subview.classForCoder.description()
+      if className.hasSuffix("CursorView") || className.contains("TextCursor") {
+        result.append(subview)
+      }
+      result.append(contentsOf: findCursorViews(in: subview))
+    }
+    return result
+  }
+
+  private static func applyHidden(_ hidden: Bool, to view: UIView) {
+    if #available(iOS 17.0, *) {
+      for cursorView in findCursorViews(in: view) {
+        cursorView.isHidden = hidden
+        cursorView.alpha = hidden ? 0 : 1
+        cursorView.layer.sublayers?.first?.isHidden = hidden
+      }
+    } else {
+      if let caretView = view.value(forKeyPath: "caretView") as? UIView {
+        caretView.isHidden = hidden
+      }
+      if let floatingView = view.value(forKeyPath: "floatingCaretView") as? UIView {
+        floatingView.isHidden = hidden
+      }
+    }
+  }
+
+  init(view: UIView) {
+    _view = view
+    Self.applyHidden(true, to: view)
+    _cancelable = view.layer.publisher(for: \.sublayers).sink { _ in
+      guard let v = self._view else { return }
+      Self.applyHidden(true, to: v)
+    }
+  }
+
+  func show() {
+    _cancelable?.cancel()
+    _cancelable = nil
+    guard let view = _view else {
+      return
+    }
+    Self.applyHidden(false, to: view)
+  }
+}

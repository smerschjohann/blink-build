+struct CodeServerView: View {
+  @EnvironmentObject private var _nav: Nav
+
+  private var _existingEntry: CodeServerEntry?
+  private var _duplicatedEntry: CodeServerEntry?
+  private var _reloadList: () -> ()
+
+  @State private var _id: UUID = UUID()
+  @State private var _alias: String = ""
+  @State private var _host: String = ""
+  @State private var _defaultFolder: String = ""
+  @State private var _certData: Data? = nil
+  @State private var _certFileName: String = ""
+  @State private var _certPassword: String = ""
+  @State private var _certSubject: String = ""
+  @State private var _certStatusError: String = ""
+  @State private var _showFileImporter: Bool = false
+  @State private var _loaded: Bool = false
+  @State private var _errorMessage: String = ""
+
+  private var _cleanAlias: String {
+    _alias.trimmingCharacters(in: .whitespacesAndNewlines)
+  }
+
+  init(entry: CodeServerEntry?, reloadList: @escaping () -> ()) {
+    _existingEntry = entry
+    _duplicatedEntry = nil
+    _reloadList = reloadList
+  }
+
+  init(duplicatingEntry entry: CodeServerEntry, reloadList: @escaping () -> ()) {
+    _existingEntry = nil
+    _duplicatedEntry = entry
+    _reloadList = reloadList
+  }
+
+  private func _usageHint() -> String {
+    var alias = _cleanAlias
+    if alias.isEmpty {
+      alias = "[alias]"
+    }
+    return "Use `code-server \(alias) [folder-path]` from the shell to connect."
+  }
+
+  var body: some View {
+    List {
+      Section(footer: Text(verbatim: _usageHint())) {
+        Field("Alias", $_alias, next: "Host", placeholder: "Required")
+      }
+
+      Section(
+        header: Text("CODE-SERVER"),
+        footer: Text("Enter the hostname or HTTPS URL of your code-server instance.")
+      ) {
+        Field("Host", $_host, next: "Folder", placeholder: "https://code.example.com:8443", kbType: .URL)
+        Field("Folder", $_defaultFolder, next: "Password", placeholder: "Optional default remote folder path")
+      }
+
+      Section(
+        header: Text("CLIENT CERTIFICATE (mTLS)"),
+        footer: Text("Import a PKCS#12 (.p12 / .pfx) bundle containing your client certificate and private key.")
+      ) {
+        if let certData = _certData, !certData.isEmpty {
+          HStack {
+            FormLabel(text: "Certificate")
+            Spacer()
+            VStack(alignment: .trailing, spacing: 2) {
+              if !_certSubject.isEmpty {
+                Label(_certSubject, systemImage: "checkmark.shield.fill")
+                  .font(.system(.subheadline))
+                  .foregroundColor(.green)
+              } else {
+                Label(_certStatusError.isEmpty ? "Password required" : _certStatusError, systemImage: "exclamationmark.triangle.fill")
+                  .font(.caption)
+                  .foregroundColor(.orange)
+              }
+              if !_certFileName.isEmpty {
+                Text(_certFileName)
+                  .font(.caption2)
+                  .foregroundColor(.secondary)
+              }
+            }
+          }
+        }
+
+        Button(action: {
+          _showFileImporter = true
+        }) {
+          Label(
+            (_certData?.isEmpty == false) ? "Replace PKCS#12 (.p12 / .pfx)..." : "Import PKCS#12 (.p12 / .pfx)...",
+            systemImage: "doc.badge.plus"
+          )
+        }
+
+        FieldPassword("Password", $_certPassword, next: "Alias", placeholder: "PKCS#12 password")
+          .onChange(of: _certPassword) { _ in
+            _refreshCertPreview()
+          }
+
+        if _certData?.isEmpty == false {
+          Button(role: .destructive, action: {
+            _certData = nil
+            _certFileName = ""
+            _certSubject = ""
+            _certStatusError = ""
+          }) {
+            Label("Remove Client Certificate", systemImage: "trash")
+              .foregroundColor(.red)
+          }
+        }
+      }
+    }
+    .listStyle(GroupedListStyle())
+    .fileImporter(
+      isPresented: $_showFileImporter,
+      allowedContentTypes: [.pkcs12, .data, .item],
+      onCompletion: _handleCertImport
+    )
+    .alert(errorMessage: $_errorMessage)
+    .navigationBarItems(
+      leading: Button("Discard", action: {
+        _nav.navController.popViewController(animated: true)
+      }),
+      trailing: Button("Save", action: {
+        guard _saveEntry() else { return }
+        _reloadList()
+        _nav.navController.popViewController(animated: true)
+      })
+    )
+    .navigationBarBackButtonHidden(true)
+    .navigationBarTitle(_existingEntry == nil ? "New Code Server" : "Code Server")
+    .onAppear {
+      if !_loaded {
+        _loadEntry()
+      }
+    }
+  }
+
+  private func _loadEntry() {
+    _loaded = true
+    if let entry = _existingEntry {
+      _id = entry.id
+      _alias = entry.alias
+      _host = entry.host
+      _defaultFolder = entry.defaultFolder
+      _certData = entry.clientCertData
+      _certFileName = entry.clientCertFileName
+      _certPassword = entry.clientCertPassword
+      _certSubject = entry.clientCertSubject
+      _refreshCertPreview()
+    } else if let dup = _duplicatedEntry {
+      _id = UUID()
+      _alias = "\(dup.alias)-copy"
+      _host = dup.host
+      _defaultFolder = dup.defaultFolder
+      _certData = dup.clientCertData
+      _certFileName = dup.clientCertFileName
+      _certPassword = dup.clientCertPassword
+      _certSubject = dup.clientCertSubject
+      _refreshCertPreview()
+    }
+  }
+
+  private func _refreshCertPreview() {
+    guard let data = _certData, !data.isEmpty else {
+      _certSubject = ""
+      _certStatusError = ""
+      return
+    }
+    do {
+      let (_, _, subject) = try CodeServerManager.validatePKCS12(data: data, password: _certPassword)
+      _certSubject = subject
+      _certStatusError = ""
+    } catch {
+      _certSubject = ""
+      _certStatusError = "Enter valid password"
+    }
+  }
+
+  private func _handleCertImport(_ result: Result<URL, Error>) {
+    do {
+      let url = try result.get()
+      let scoped = url.startAccessingSecurityScopedResource()
+      defer {
+        if scoped {
+          url.stopAccessingSecurityScopedResource()
+        }
+      }
+      let data = try Data(contentsOf: url, options: .alwaysMapped)
+      _certData = data
+      _certFileName = url.lastPathComponent
+      _refreshCertPreview()
+    } catch {
+      _errorMessage = "Could not read certificate file: \(error.localizedDescription)"
+    }
+  }
+
+  private func _saveEntry() -> Bool {
+    let entry = CodeServerEntry(
+      id: _id,
+      alias: _alias,
+      host: _host,
+      defaultFolder: _defaultFolder,
+      clientCertData: _certData,
+      clientCertFileName: _certFileName,
+      clientCertPassword: _certPassword,
+      clientCertSubject: _certSubject
+    )
+    do {
+      try CodeServerManager.shared.upsertEntry(entry)
+      return true
+    } catch {
+      _errorMessage = error.localizedDescription
+      return false
+    }
+  }
+}

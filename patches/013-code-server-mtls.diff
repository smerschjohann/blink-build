+// MARK: - mTLS Code-Server Integration
+
+public enum CodeServerError: Error, LocalizedError {
+  case emptyAlias
+  case invalidAliasWhitespace
+  case duplicateAlias(String)
+  case emptyHost
+  case invalidHostURL(String)
+  case invalidCertPassword
+  case pkcs12ImportFailed(OSStatus)
+  case noIdentityInPKCS12
+  case storageError(String)
+
+  public var errorDescription: String? {
+    switch self {
+    case .emptyAlias:
+      return "Alias is required."
+    case .invalidAliasWhitespace:
+      return "Spaces are not permitted in the alias."
+    case .duplicateAlias(let alias):
+      return "A code-server with alias '\(alias)' already exists."
+    case .emptyHost:
+      return "Host / URL is required."
+    case .invalidHostURL(let host):
+      return "Invalid Host / URL: \(host)"
+    case .invalidCertPassword:
+      return "Invalid password for PKCS#12 client certificate."
+    case .pkcs12ImportFailed(let status):
+      return "Could not import PKCS#12 client certificate (OSStatus \(status))."
+    case .noIdentityInPKCS12:
+      return "PKCS#12 file does not contain a valid client identity (certificate + private key)."
+    case .storageError(let msg):
+      return "Failed to save code-server configuration: \(msg)"
+    }
+  }
+}
+
+public struct CodeServerEntry: Codable, Identifiable, Equatable {
+  public var id: UUID
+  public var alias: String
+  public var host: String
+  public var defaultFolder: String
+  public var clientCertData: Data?
+  public var clientCertFileName: String
+  public var clientCertPassword: String
+  public var clientCertSubject: String
+
+  public init(
+    id: UUID = UUID(),
+    alias: String,
+    host: String,
+    defaultFolder: String = "",
+    clientCertData: Data? = nil,
+    clientCertFileName: String = "",
+    clientCertPassword: String = "",
+    clientCertSubject: String = ""
+  ) {
+    self.id = id
+    self.alias = alias
+    self.host = host
+    self.defaultFolder = defaultFolder
+    self.clientCertData = clientCertData
+    self.clientCertFileName = clientCertFileName
+    self.clientCertPassword = clientCertPassword
+    self.clientCertSubject = clientCertSubject
+  }
+
+  public func normalizedBaseURL() -> URL? {
+    let trimmed = host.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !trimmed.isEmpty else { return nil }
+    let urlString: String
+    if trimmed.lowercased().hasPrefix("http://") || trimmed.lowercased().hasPrefix("https://") {
+      urlString = trimmed
+    } else {
+      urlString = "https://\(trimmed)"
+    }
+    guard let url = URL(string: urlString), let urlHost = url.host, !urlHost.isEmpty else {
+      return nil
+    }
+    return url
+  }
+
+  public func resolvedURL(folderPath: String? = nil) -> URL? {
+    guard let baseURL = normalizedBaseURL() else { return nil }
+    let effectivePath = (folderPath?.trimmingCharacters(in: .whitespacesAndNewlines)).flatMap { $0.isEmpty ? nil : $0 }
+      ?? (defaultFolder.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? nil : defaultFolder.trimmingCharacters(in: .whitespacesAndNewlines))
+
+    guard let path = effectivePath, !path.isEmpty else {
+      return baseURL
+    }
+
+    guard var components = URLComponents(url: baseURL, resolvingAgainstBaseURL: false) else {
+      return baseURL
+    }
+    let queryKey = path.hasSuffix(".code-workspace") ? "workspace" : "folder"
+    var queryItems = (components.queryItems ?? []).filter { $0.name != "folder" && $0.name != "workspace" }
+    queryItems.append(URLQueryItem(name: queryKey, value: path))
+    components.queryItems = queryItems
+    return components.url ?? baseURL
+  }
+}
+
+@objc public class CodeServerManager: NSObject {
+  @objc public static let shared = CodeServerManager()
+
+  private let fm = FileManager.default
+
+  private var storageURL: URL {
+    let dir = BlinkPaths.blinkURL()!
+    if !fm.fileExists(atPath: dir.path) {
+      try? fm.createDirectory(at: dir, withIntermediateDirectories: true)
+    }
+    return dir.appendingPathComponent("code-servers.json")
+  }
+
+  public func loadEntries() -> [CodeServerEntry] {
+    let url = storageURL
+    guard fm.fileExists(atPath: url.path),
+          let data = try? Data(contentsOf: url),
+          let entries = try? JSONDecoder().decode([CodeServerEntry].self, from: data)
+    else {
+      return []
+    }
+    return entries
+  }
+
+  public func saveEntries(_ entries: [CodeServerEntry]) throws {
+    let encoder = JSONEncoder()
+    encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+    do {
+      let data = try encoder.encode(entries)
+      try data.write(to: storageURL, options: [.atomic])
+    } catch {
+      throw CodeServerError.storageError(error.localizedDescription)
+    }
+  }
+
+  public func upsertEntry(_ entry: CodeServerEntry) throws {
+    let cleanAlias = entry.alias.trimmingCharacters(in: .whitespacesAndNewlines)
+    if cleanAlias.isEmpty {
+      throw CodeServerError.emptyAlias
+    }
+    if cleanAlias.rangeOfCharacter(from: .whitespacesAndNewlines) != nil {
+      throw CodeServerError.invalidAliasWhitespace
+    }
+    let cleanHost = entry.host.trimmingCharacters(in: .whitespacesAndNewlines)
+    if cleanHost.isEmpty {
+      throw CodeServerError.emptyHost
+    }
+
+    var normalizedEntry = entry
+    normalizedEntry.alias = cleanAlias
+    normalizedEntry.host = cleanHost
+    normalizedEntry.defaultFolder = entry.defaultFolder.trimmingCharacters(in: .whitespacesAndNewlines)
+
+    guard normalizedEntry.normalizedBaseURL() != nil else {
+      throw CodeServerError.invalidHostURL(cleanHost)
+    }
+
+    if let certData = normalizedEntry.clientCertData, !certData.isEmpty {
+      let (_, _, subject) = try Self.validatePKCS12(data: certData, password: normalizedEntry.clientCertPassword)
+      normalizedEntry.clientCertSubject = subject
+    } else {
+      normalizedEntry.clientCertFileName = ""
+      normalizedEntry.clientCertSubject = ""
+    }
+
+    var entries = loadEntries()
+    if entries.contains(where: { $0.id != normalizedEntry.id && $0.alias.lowercased() == cleanAlias.lowercased() }) {
+      throw CodeServerError.duplicateAlias(cleanAlias)
+    }
+
+    if let idx = entries.firstIndex(where: { $0.id == normalizedEntry.id }) {
+      entries[idx] = normalizedEntry
+    } else {
+      entries.append(normalizedEntry)
+    }
+    try saveEntries(entries)
+  }
+
+  public func deleteEntry(id: UUID) {
+    var entries = loadEntries()
+    entries.removeAll { $0.id == id }
+    try? saveEntries(entries)
+  }
+
+  public func entry(forAlias alias: String) -> CodeServerEntry? {
+    let trimmed = alias.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+    return loadEntries().first { $0.alias.lowercased() == trimmed }
+  }
+
+  public func allAliases() -> [String] {
+    loadEntries().map { $0.alias }.sorted()
+  }
+
+  public static func validatePKCS12(data: Data, password: String) throws -> (SecIdentity, [SecCertificate], String) {
+    var rawItems: CFArray?
+    let options: [String: Any] = [
+      kSecImportExportPassphrase as String: password
+    ]
+    let status = SecPKCS12Import(data as NSData, options as CFDictionary, &rawItems)
+    guard status == errSecSuccess else {
+      if status == errSecAuthFailed || status == errSecPkcs12VerifyFailure {
+        throw CodeServerError.invalidCertPassword
+      }
+      throw CodeServerError.pkcs12ImportFailed(status)
+    }
+
+    guard
+      let items = rawItems as? [[String: Any]],
+      let firstItem = items.first,
+      let rawIdentity = firstItem[kSecImportItemIdentity as String]
+    else {
+      throw CodeServerError.noIdentityInPKCS12
+    }
+
+    let secIdentity = rawIdentity as! SecIdentity
+    let certChain = (firstItem[kSecImportItemCertChain as String] as? [SecCertificate]) ?? []
+
+    var secCert: SecCertificate?
+    SecIdentityCopyCertificate(secIdentity, &secCert)
+    let subject = secCert.flatMap { SecCertificateCopySubjectSummary($0) as String? } ?? "Client Certificate"
+
+    return (secIdentity, certChain, subject)
+  }
+
+  @objc(credentialForHost:port:)
+  public func credential(forHost host: String, port: Int) -> URLCredential? {
+    let lowerHost = host.lowercased()
+    let entries = loadEntries().filter {
+      guard let certData = $0.clientCertData, !certData.isEmpty else { return false }
+      guard let url = $0.normalizedBaseURL(), let entryHost = url.host?.lowercased() else { return false }
+      return entryHost == lowerHost
+    }
+
+    guard !entries.isEmpty else {
+      return nil
+    }
+
+    // Prefer exact port match first, then fallback to host match
+    let matchedEntry = entries.first(where: { entry in
+      guard let url = entry.normalizedBaseURL() else { return false }
+      let entryPort = url.port ?? (url.scheme?.lowercased() == "http" ? 80 : 443)
+      return port <= 0 || entryPort == port
+    }) ?? entries[0]
+
+    guard
+      let certData = matchedEntry.clientCertData,
+      let (identity, certChain, _) = try? Self.validatePKCS12(data: certData, password: matchedEntry.clientCertPassword)
+    else {
+      return nil
+    }
+
+    let intermediates: [SecCertificate]? = certChain.count > 1 ? Array(certChain.dropFirst()) : nil
+    return URLCredential(identity: identity, certificates: intermediates, persistence: .forSession)
+  }
+}
+
+struct CodeServerCommand: NonStdIOCommand {
+  static var configuration = CommandConfiguration(
+    commandName: "code-server",
+    abstract: "Starts mTLS code-server editor for a configured alias",
+    discussion: """
+      Connects to a configured code-server instance using mTLS client certificates
+      and Blink's native keyboard integration (without the iOS PWA keyboard overlay).
+      Configure instances in Settings -> Connect -> Code Servers.
+      To close the editor, use your Blink close tab shortcut (default Cmd-W).
+      """
+  )
+
+  @OptionGroup var verboseOptions: VerboseOptions
+  var io = NonStdIO.standard
+
+  @Flag(name: .shortAndLong, help: "List configured code-server aliases")
+  var list: Bool = false
+
+  @Argument(help: "Configured code-server alias")
+  var alias: String?
+
+  @Argument(help: "Optional remote folder or workspace path to open")
+  var folderPath: String?
+
+  mutating func run() throws {
+    let entries = CodeServerManager.shared.loadEntries()
+
+    if list {
+      if entries.isEmpty {
+        print("No code-server instances configured. Add one in Settings -> Connect -> Code Servers.")
+      } else {
+        for entry in entries.sorted(by: { $0.alias < $1.alias }) {
+          let certInfo = (entry.clientCertData?.isEmpty == false)
+            ? " [mTLS: \(entry.clientCertSubject.isEmpty ? entry.clientCertFileName : entry.clientCertSubject)]"
+            : ""
+          print("\(entry.alias)\t\(entry.host)\(certInfo)")
+        }
+      }
+      return
+    }
+
+    guard let alias = alias?.trimmingCharacters(in: .whitespacesAndNewlines), !alias.isEmpty else {
+      if !entries.isEmpty {
+        print("Configured code-server aliases: \(entries.map { $0.alias }.sorted().joined(separator: ", "))")
+      } else {
+        print("No code-server aliases configured yet. Add one in Settings -> Connect -> Code Servers.")
+      }
+      throw CleanExit.helpRequest(self)
+    }
+
+    guard let entry = CodeServerManager.shared.entry(forAlias: alias) else {
+      let available = entries.map { $0.alias }.sorted().joined(separator: ", ")
+      let hint = available.isEmpty ? "Configure aliases in Settings -> Connect -> Code Servers." : "Available aliases: \(available)"
+      throw CommandError(message: "Unknown code-server alias '\(alias)'. \(hint)")
+    }
+
+    if let certData = entry.clientCertData, !certData.isEmpty {
+      do {
+        _ = try CodeServerManager.validatePKCS12(data: certData, password: entry.clientCertPassword)
+      } catch {
+        throw CommandError(message: "Client certificate error for '\(entry.alias)': \(error.localizedDescription)")
+      }
+    }
+
+    guard let targetURL = entry.resolvedURL(folderPath: folderPath) else {
+      throw CommandError(message: "Invalid URL configured for code-server '\(entry.alias)': \(entry.host)")
+    }
+
+    let session = Unmanaged<MCPSession>.fromOpaque(thread_context).takeUnretainedValue()
+    let view = session.device?.view
+    DispatchQueue.main.async {
+      view?.addBrowserWebView(targetURL, agent: "", injectUIO: true)
+    }
+  }
+}
+
+@_cdecl("codeserver_main")
+public func codeserver_main(argc: Int32, argv: Argv) -> Int32 {
+  setvbuf(thread_stdin,  nil, _IONBF, 0)
+  setvbuf(thread_stdout, nil, _IONBF, 0)
+  setvbuf(thread_stderr, nil, _IONBF, 0)
+
+  let io = NonStdIO.standard
+  io.in_ = InputStream(file: thread_stdin)
+  io.out = OutputStream(file: thread_stdout)
+  io.err = OutputStream(file: thread_stderr)
+
+  return CodeServerCommand.main(Array(argv.args(count: argc)[1...]), io: io)
+}

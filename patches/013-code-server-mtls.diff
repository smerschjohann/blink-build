+struct CodeServerListView: View {
+  @StateObject private var _state = CodeServersObservable()
+  @EnvironmentObject private var _nav: Nav
+
+  var body: some View {
+    Group {
+      if _state.list.isEmpty {
+        EmptyStateView(
+          action: Button(
+            action: _addCodeServer,
+            label: { Label("Add Code Server", systemImage: "plus") }
+          ),
+          systemIconName: "chevron.left.forwardslash.chevron.right",
+          description: "Configure code-server instances with mTLS client certificates to use with the `code-server` command."
+        )
+      } else {
+        Group {
+          if _state.filteredList.isEmpty {
+            EmptyStateView(
+              action: Button(
+                action: _addCodeServer,
+                label: { Label("Add Code Server", systemImage: "plus") }
+              ),
+              systemIconName: "chevron.left.forwardslash.chevron.right"
+            )
+          } else {
+            List {
+              ForEach(Array(_state.filteredList.enumerated()), id: \.element.id) { index, entry in
+                CodeServerRow(entry: entry, reloadList: _state.reloadEntries)
+                  .contextMenu(menuItems: {
+                    Button(action: {
+                      _duplicateCodeServer(entry: entry)
+                    }, label: { Label("Duplicate", systemImage: "plus.square.on.square") })
+                    Divider()
+                    Button(role: .destructive, action: {
+                      _state.deleteEntries(indexSet: IndexSet([index]))
+                    }, label: { Label("Delete", systemImage: "trash") })
+                  })
+              }.onDelete(perform: _state.deleteEntries)
+            }
+            .listStyle(InsetGroupedListStyle())
+            .navigationBarItems(
+              trailing: HStack {
+                Menu {
+                  Section(header: Text("Order")) {
+                    SortButton(label: "Alias", sortType: $_state.sortType, asc: .aliasAsc, desc: .aliasDesc)
+                    SortButton(label: "Host",  sortType: $_state.sortType, asc: .hostAsc,  desc: .hostDesc)
+                  }
+                } label: { Image(systemName: "list.bullet").frame(width: 38, height: 38, alignment: .center) }
+                Button(
+                  action: _addCodeServer,
+                  label: { Image(systemName: "plus").frame(width: 38, height: 38, alignment: .center) }
+                )
+              }
+            )
+          }
+        }
+        .searchable(text: $_state.filterQuery)
+      }
+    }
+    .onAppear(perform: _state.reloadEntries)
+    .navigationBarTitle("Code Servers")
+  }
+
+  private func _addCodeServer() {
+    let rootView = CodeServerView(entry: nil, reloadList: _state.reloadEntries).environmentObject(_nav)
+    let vc = UIHostingController(rootView: rootView)
+    _nav.navController.pushViewController(vc, animated: true)
+  }
+
+  private func _duplicateCodeServer(entry: CodeServerEntry) {
+    let rootView = CodeServerView(duplicatingEntry: entry, reloadList: _state.reloadEntries).environmentObject(_nav)
+    let vc = UIHostingController(rootView: rootView)
+    _nav.navController.pushViewController(vc, animated: true)
+  }

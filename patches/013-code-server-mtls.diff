+
+fileprivate class CodeServersObservable: ObservableObject {
+  enum SortType {
+    case aliasAsc, aliasDesc, hostAsc, hostDesc
+
+    var sortFn: (_ a: CodeServerEntry, _ b: CodeServerEntry) -> Bool {
+      switch self {
+      case .aliasAsc:  return { a, b in a.alias < b.alias }
+      case .aliasDesc: return { a, b in b.alias < a.alias }
+      case .hostAsc:   return { a, b in a.host < b.host }
+      case .hostDesc:  return { a, b in b.host < a.host }
+      }
+    }
+  }
+
+  @Published var filterQuery: String = "" {
+    didSet {
+      filterIfNeeded()
+    }
+  }
+
+  @Published var sortType: SortType = .aliasAsc {
+    didSet {
+      list = list.sorted(by: sortType.sortFn)
+      filterIfNeeded()
+    }
+  }
+
+  @Published var filteredList: [CodeServerEntry] = []
+
+  var list: [CodeServerEntry] = CodeServerManager.shared.loadEntries()
+    .sorted(by: SortType.aliasAsc.sortFn)
+
+  init() {
+    filterIfNeeded()
+  }
+
+  func filterIfNeeded() {
+    let trimmedQuery = filterQuery.trimmingCharacters(in: .whitespacesAndNewlines)
+    if trimmedQuery.isEmpty {
+      filteredList = list
+      return
+    }
+    filteredList = list.filter { entry in
+      entry.alias.localizedCaseInsensitiveContains(trimmedQuery) ||
+      entry.host.localizedCaseInsensitiveContains(trimmedQuery) ||
+      entry.clientCertSubject.localizedCaseInsensitiveContains(trimmedQuery)
+    }
+  }
+
+  func reloadEntries() {
+    list = CodeServerManager.shared.loadEntries().sorted(by: sortType.sortFn)
+    filterIfNeeded()
+  }
+
+  func deleteEntries(indexSet: IndexSet) {
+    let entriesToDelete = indexSet.map { filteredList[$0] }
+    for entry in entriesToDelete {
+      CodeServerManager.shared.deleteEntry(id: entry.id)
+    }
+    reloadEntries()
+  }
+}

diff --git a/KB/Native/Views/KBConfigView.swift b/KB/Native/Views/KBConfigView.swift
index 0a0bb6e..74281b3 100644
--- a/KB/Native/Views/KBConfigView.swift
+++ b/KB/Native/Views/KBConfigView.swift
@@ -128,6 +128,11 @@ struct KBConfigView: View {
     .onReceive(config.objectWillChange.debounce(for: 0.5, scheduler: RunLoop.main)) {
       KBTracker.shared.save(config: self.config)
     }
+    .onDisappear {
+      // The debounced save is cancelled when the view leaves the hierarchy,
